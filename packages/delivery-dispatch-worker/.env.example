# Delivery dispatch Temporal worker (§H H1) — host process only.
# Infra ready — awaiting TEMPORAL_ADDRESS + SUPABASE_SERVICE_ROLE_KEY for live run.
# Never commit real values. Never ship service_role to apps/* or clients.

# Required (fail-closed — worker refuses start if unset)
TEMPORAL_ADDRESS=localhost:7233
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=gtr-delivery-dispatch
# DISPATCH_AUTO_ACCEPT_OFFERS=1
