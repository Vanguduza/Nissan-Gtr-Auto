# Placeholders only — never commit real keys
# Prefer Live RpcClient when both are set in local.properties → BuildConfig.
# Fake only if unset or rpc.forceFake=true.
# Mirror root `.env.example` / web NEXT_PUBLIC_SUPABASE_* (without NEXT_PUBLIC_ prefix).
# Copy into local.properties (gitignored):
#   SUPABASE_URL=...
#   SUPABASE_ANON_KEY=...
#   SUPPORT_PHONE=+263XXXXXXXXX
#   OSRM_URL=http://10.0.2.2:5000   # preferred distance/ETA SoR (eta_source=osrm)
#   MAPLIBRE_STYLE_URL=http://10.0.2.2:8081/styles/basic-preview/style.json
#   GOOGLE_MAPS_API_KEY=...         # deprecated Maps/Directions fallback only
#   useMapLibre=false               # optional — forces deprecated Google map surface
# Optional: rpc.forceFake=true  → always use FakeRpcClient
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPPORT_PHONE=
OSRM_URL=
MAPLIBRE_STYLE_URL=
GOOGLE_MAPS_API_KEY=
