# Hosted vs local — see docs/guides/hosted-supabase-cutover.md
# HOSTED:  NEXT_PUBLIC_SUPABASE_URL=https://bicyjghgdnzlnjqxzoud.supabase.co
#          NEXT_PUBLIC_SUPABASE_ANON_KEY=<Dashboard → API → publishable/anon>
# LOCAL:   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#          NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status anon key>
# Copy this file to .env.local (gitignored). Never commit real keys.
# PROD / Preview: https://nissangtrauto.co.zw or https://<project>.vercel.app
# LOCAL only:      http://127.0.0.1:3000  (middleware skips HTTPS upgrade for localhost)
NEXT_PUBLIC_SITE_URL=https://nissangtrauto.co.zw
NEXT_PUBLIC_SUPABASE_URL=https://bicyjghgdnzlnjqxzoud.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Customer OAuth (Google / Apple): clients use URL + anon only.
# Redirect allow-list must include {SITE_URL}/auth/callback — see docs/CUSTOMER_OAUTH_SETUP.md
# Prod callbacks must be https:// (apex, www, and vercel.app if used).
# Hosted providers: Dashboard only (config.toml is local). Cutover: docs/guides/hosted-supabase-cutover.md
# Provider secrets stay in Supabase Dashboard / SUPABASE_AUTH_EXTERNAL_* (never NEXT_PUBLIC_*).
# Optional storefront defaults (anon only — no secrets)
NEXT_PUBLIC_DEFAULT_WAREHOUSE_ID=
NEXT_PUBLIC_ZIG_EXCHANGE_RATE=1

# MapLibre style JSON URL for customer /track/[token] and staff live map.
# Must be MapLibre-compatible (not Google Maps JS — Google requires billing/API
# key and is not a drop-in for MapLibre).
#
# Customer track: map renders only when this is set; otherwise coordinates+ETA
# text fallback (no historical trail either way).
#
# Staff live map when unset: CARTO Positron GL (keyless, Harare-visible):
#   https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# If that style fails, the map falls back to inline CARTO light raster tiles.
# Alternatives (also keyless):
#   https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# Production keyed tiles (MapTiler / self-hosted): put URL only in .env.local.
NEXT_PUBLIC_MAP_STYLE_URL=

# Meilisearch CE — server/Edge only (docker-compose.satellites.yml --profile search).
# DO NOT put Meili keys in the browser. Clients call Edge function catalog-search-meili.
# Set MEILI_HOST + MEILI_SEARCH_KEY (search-only) as Supabase Edge secrets / sync env.
# MEILI_MASTER_KEY is for data-pipeline meili_sync only — never NEXT_PUBLIC_*.

# Out-for-delivery SMS/WA: web calls update_delivery_job_status → backend
# enqueues sms_outbox (delivery_out_for_delivery). Edge process-sms-outbox
# fail-closes without SMS_GATEWAY_API_KEY (Edge secret — never NEXT_PUBLIC_*).
# Optional WhatsApp Cloud for other channels: WHATSAPP_ACCESS_TOKEN +
# WHATSAPP_PHONE_NUMBER_ID (Edge only). No gateway keys → silent skip / 503.

# ---------------------------------------------------------------------------
# ContiPay / Paynow — Edge Function secrets ONLY (never NEXT_PUBLIC_*, never commit)
# Set on supabase functions env / dashboard. Local stubs:
#   CONTIPAY_ALLOW_UNVERIFIED_LOCAL=1
#   PAYNOW_ALLOW_UNVERIFIED_LOCAL=1
# Real provider HMAC + hosted checkout_url need (Edge only):
#   CONTIPAY_API_KEY, CONTIPAY_API_SECRET, CONTIPAY_MERCHANT_ID
#   CONTIPAY_WEBHOOK_HMAC_SECRET (HMAC-SHA256 raw body → x-contipay-signature)
#   CONTIPAY_MODE=live|dev (optional), CONTIPAY_API_BASE_URL (optional override)
#   PAYNOW_INTEGRATION_ID, PAYNOW_INTEGRATION_KEY
# ContiPay initiate also needs phone (or metadata.phone) on the invoke body.
# Storefront return/cancel: /checkout/return and /checkout/cancel
# (built from NEXT_PUBLIC_SITE_URL). See docs/storefront-psp-return-urls.md
# ---------------------------------------------------------------------------
