NEXT_PUBLIC_SITE_URL=https://nissangtrauto.co.zw
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional storefront defaults (anon only — no secrets)
NEXT_PUBLIC_DEFAULT_WAREHOUSE_ID=
NEXT_PUBLIC_ZIG_EXCHANGE_RATE=1

# MapLibre style URL for staff live delivery map (/staff/logistics/tracking).
# Local demo fallback (built-in): https://demotiles.maplibre.org/style.json
# Production: MapTiler / self-hosted / other MapLibre-compatible style — do not
# commit API keys; put keyed URLs only in .env.local.
NEXT_PUBLIC_MAP_STYLE_URL=

# ---------------------------------------------------------------------------
# ContiPay / Paynow — Edge Function secrets ONLY (never NEXT_PUBLIC_*, never commit)
# Set on supabase functions env / dashboard. Local stubs:
#   CONTIPAY_ALLOW_UNVERIFIED_LOCAL=1
#   PAYNOW_ALLOW_UNVERIFIED_LOCAL=1
# Real provider HMAC + hosted checkout_url need (Edge only):
#   CONTIPAY_API_KEY, CONTIPAY_API_SECRET, CONTIPAY_MERCHANT_ID
#   CONTIPAY_WEBHOOK_HMAC_SECRET (HMAC-SHA256 raw body → x-contipay-signature)
#   CONTIPAY_MODE=live|dev (optional), CONTIPAY_API_BASE_URL (optional override)
#   PAYNOW_INTEGRATION_ID, PAYNOW_INTEGRATION_KEY
# ContiPay initiate also needs phone (or metadata.phone) on the invoke body.
# Storefront return/cancel: /checkout/return and /checkout/cancel
# (built from NEXT_PUBLIC_SITE_URL). See docs/storefront-psp-return-urls.md
# ---------------------------------------------------------------------------
