# Placeholders only — never commit real keys
# Prefer Live RpcClient when both are set in local.properties -> BuildConfig.
# Fake only if unset or rpc.forceFake=true.
# Mirror root `.env.example` / web NEXT_PUBLIC_SUPABASE_* (without NEXT_PUBLIC_ prefix).
# Cutover: docs/guides/hosted-supabase-cutover.md
# HOSTED: SUPABASE_URL=https://gylrgwqyuiwkyykardwc.supabase.co + Dashboard anon
# LOCAL:  SUPABASE_URL=http://127.0.0.1:54321 + `supabase status` anon
# Copy into local.properties (gitignored):
#   SUPABASE_URL=...
#   SUPABASE_ANON_KEY=...
# Optional: rpc.forceFake=true  -> always use FakeRpcClient
# Optional: WHATSAPP_E164=263770000000  (digits only; wa.me CTA)
SUPABASE_URL=https://gylrgwqyuiwkyykardwc.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Maps — MapLibre SoR (B-MAP-1). Google key = deprecated fallback only.
# useMapLibre=false
# GOOGLE_MAPS_API_KEY=

# Google Sign-In (Credential Manager -> Supabase ID token). Names only — never commit secrets.
# Use the Web OAuth client ID as serverClientId (not the Android client ID).
# Also create an Android OAuth client in Google Cloud (package co.zw.nissangtr.customer + SHA-1).
# Checklist: docs/CUSTOMER_OAUTH_SETUP.md
# GOOGLE_WEB_CLIENT_ID=
# Alias also accepted:
# GOOGLE_SERVER_CLIENT_ID=
