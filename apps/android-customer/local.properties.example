## This file is an example — copy to local.properties (gitignored). Never commit real keys.
## sdk.dir is required by the Android Gradle Plugin when the SDK is not auto-detected.
# sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

# Same names as root .env.example / web NEXT_PUBLIC_SUPABASE_* (without NEXT_PUBLIC_ prefix)
# Hosted cutover: docs/guides/hosted-supabase-cutover.md
# HOSTED: https://gylrgwqyuiwkyykardwc.supabase.co + Dashboard anon
# LOCAL:  http://127.0.0.1:54321 + `supabase status` anon
SUPABASE_URL=https://gylrgwqyuiwkyykardwc.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: force FakeRpcClient even when URL+key are set
# rpc.forceFake=true
