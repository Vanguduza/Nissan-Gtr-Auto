// Committed defaults — secrets live in Secrets.xcconfig (gitignored).
// Copy Secrets.xcconfig.example → Secrets.xcconfig at apps/ios/.

SUPABASE_URL =
SUPABASE_ANON_KEY =
STOREFRONT_FORCE_FAKE =
WHATSAPP_E164 =
// MapLibre SoR (B-MAP-1). Set USE_MAPLIBRE=false only for deprecated MapKit.
USE_MAPLIBRE =
MAPLIBRE_STYLE_URL =

#include? "../Secrets.xcconfig"

// Prefer Live when URL + anon are set (AppEnv reads these Info.plist keys).
INFOPLIST_KEY_SUPABASE_URL = $(SUPABASE_URL)
INFOPLIST_KEY_SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)
INFOPLIST_KEY_STOREFRONT_FORCE_FAKE = $(STOREFRONT_FORCE_FAKE)
INFOPLIST_KEY_WHATSAPP_E164 = $(WHATSAPP_E164)
INFOPLIST_KEY_USE_MAPLIBRE = $(USE_MAPLIBRE)
INFOPLIST_KEY_MAPLIBRE_STYLE_URL = $(MAPLIBRE_STYLE_URL)
