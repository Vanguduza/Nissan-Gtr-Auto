# Placeholders only — never commit real keys
# Prefer Live when both are set (scheme env and/or Secrets.xcconfig → Info.plist).
# Fake only if unset or STOREFRONT_FORCE_FAKE is on.
# Mirror root `.env.example` / web NEXT_PUBLIC_SUPABASE_* (without NEXT_PUBLIC_ prefix).
# Cutover: docs/guides/hosted-supabase-cutover.md
# HOSTED: https://bicyjghgdnzlnjqxzoud.supabase.co + replacement publishable/anon key
# LOCAL:  http://127.0.0.1:54321 + `supabase status` anon
SUPABASE_URL=https://bicyjghgdnzlnjqxzoud.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional bootstrap JWT (scheme env only — skips Sign-in until Sign out).
# Prefer the in-app email/password screen — tokens also persist in AuthTokenStore.
# SUPABASE_ACCESS_TOKEN=

# Force FakeStorefrontApi even when URL + anon are set (1|true|yes)
# STOREFRONT_FORCE_FAKE=1

# Optional WhatsApp CTA digits for wa.me (defaults to 263770000000 like web)
# WHATSAPP_E164=263770000000
