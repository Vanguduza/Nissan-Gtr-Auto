# Placeholders only — never commit real keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional bootstrap JWT (skips Sign-in until Sign out). Prefer the in-app
# email/password screen — tokens also persist in UserDefaults (AuthTokenStore).
# SUPABASE_ACCESS_TOKEN=

# Force FakeStorefrontApi even when URL + anon are set (1|true|yes)
# STOREFRONT_FORCE_FAKE=1
