# Placeholders only — never commit real keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: customer session JWT for AuthZ RPCs (customers.profile_id = auth.uid()).
# When unset, Live uses the anon key as Bearer — customer RPCs will 401 until sign-in.
# SUPABASE_ACCESS_TOKEN=

# Force FakeStorefrontApi even when URL + anon are set (1|true|yes)
# STOREFRONT_FORCE_FAKE=1
