// Copy to Secrets.xcconfig (gitignored) at apps/ios/.
// Release requires this approved HTTPS project and its matching public client key.
// Debug previews alone may use Fake when unset or STOREFRONT_FORCE_FAKE.
// $() keeps the URL slashes from becoming an xcconfig comment.
// Cutover: docs/guides/hosted-supabase-cutover.md
// HOSTED: https://bicyjghgdnzlnjqxzoud.supabase.co + Dashboard publishable/anon key
// LOCAL:  http://127.0.0.1:54321 + `supabase status` anon

SUPABASE_URL = https:/$()/bicyjghgdnzlnjqxzoud.supabase.co
SUPABASE_ANON_KEY =

// Optional: force FakeStorefrontApi even when URL + anon are set (1|true|yes)
// STOREFRONT_FORCE_FAKE = 1

// Optional WhatsApp wa.me digits; blank disables the CTA
// WHATSAPP_E164 = 263XXXXXXXXX
