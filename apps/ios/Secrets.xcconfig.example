// Copy to Secrets.xcconfig (gitignored) at apps/ios/.
// Prefer Live when both URL + anon are non-empty; Fake only if unset or STOREFRONT_FORCE_FAKE.
// Cutover: docs/guides/hosted-supabase-cutover.md
// HOSTED: https://gylrgwqyuiwkyykardwc.supabase.co + Dashboard anon
// LOCAL:  http://127.0.0.1:54321 + `supabase status` anon

SUPABASE_URL = https://gylrgwqyuiwkyykardwc.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// Optional: force FakeStorefrontApi even when URL + anon are set (1|true|yes)
// STOREFRONT_FORCE_FAKE = 1

// Optional WhatsApp wa.me digits (defaults to 263770000000 like web)
// WHATSAPP_E164 = 263770000000

// MapLibre SoR (B-MAP-1 / H5-iOS). Default on when unset.
// USE_MAPLIBRE = false
// MAPLIBRE_STYLE_URL = https://demotiles.maplibre.org/style.json
