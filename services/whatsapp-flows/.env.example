# Local / deploy env for WhatsApp Flows FastAPI (never commit real secrets)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ALLOW_UNVERIFIED_LOCAL=true

FLOW_PRIVATE_KEY_PATH=keys/private.pem

DEFAULT_CURRENCY=USD
RETAIL_PRICE_LIST_CODE=RETAIL
DELIVERY_FEE_COUNTER_COLLECT=0
DELIVERY_FEE_HARARE=5
DELIVERY_FEE_NATIONWIDE=15

PUBLIC_BASE_URL=http://127.0.0.1:3000
SITE_CHECKOUT_PATH=/checkout/pay
ALLOW_PAYMENT_STUB=true

# Default WhatsApp checkout rail: ecocash | paynow
DEFAULT_WHATSAPP_PAYMENT_PROVIDER=ecocash

# EcoCash Instant Payments — plug in after https://developers.ecocash.co.zw/ registration
# 1) Merchant account + Online Merchant approval
# 2) Create app → copy API key
# 3) Set ECOCASH_ENVIRONMENT=live and ECOCASH_ALLOW_STUB=false
ECOCASH_API_KEY=
ECOCASH_ENVIRONMENT=sandbox
ECOCASH_API_BASE_URL=https://developers.ecocash.co.zw/api/ecocash_pay
ECOCASH_C2B_PATH_SANDBOX=/api/v2/payment/instant/c2b/sandbox
ECOCASH_C2B_PATH_LIVE=/api/v2/payment/instant/c2b/live
ECOCASH_LOOKUP_PATH=/api/v1/transaction/transactions/lookup
ECOCASH_AUTH_HEADER=x-api-key
ECOCASH_ALLOW_STUB=true
# Optional: when EcoCash documents webhook signing, set the shared secret
ECOCASH_WEBHOOK_SECRET=
