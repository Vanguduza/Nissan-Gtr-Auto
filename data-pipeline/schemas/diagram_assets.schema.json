{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagram_assets.schema.json",
  "title": "diagram_assets",
  "type": "object",
  "required": ["storage_path", "pnc_code", "chassis_code"],
  "additionalProperties": false,
  "properties": {
    "storage_path": { "type": "string", "minLength": 1 },
    "pnc_code": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^[0-9A-Z]{2,8}$"
    },
    "chassis_code": { "type": "string", "maxLength": 32 },
    "engine_code": { "type": "string", "maxLength": 32 },
    "content_type": {
      "type": "string",
      "enum": ["image/png", "image/jpeg", "image/webp", "image/svg+xml", "image/gif"]
    },
    "source_url": { "type": "string" },
    "provenance": {
      "type": "string",
      "description": "Asset origin marker. Fixture packs use 'original-fixture-art' (rights-cleared placeholder art, never scraped). 'scraped-reference' is for Amayama/7zap/PartSouq captures — review rights before production publish.",
      "enum": [
        "original-fixture-art",
        "licensed-fast",
        "customer-supplied",
        "scraped-reference"
      ]
    }
  }
}
