{
  "base_url": "https://partsouq.com",
  "start_url": "https://partsouq.com/en/catalog/genuine/locate?c=Nissan",
  "user_agent": "GTR-Auto-CatalogBot/1.0 (+https://nissangtrauto.co.zw/bot)",
  "session_user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
  "rate_limit_seconds": 1.5,
  "jitter_seconds": 0.75,
  "jitter_ratio": 0.35,
  "max_retries": 5,
  "backoff_base_seconds": 2.0,
  "backoff_max_seconds": 60.0,
  "max_concurrent_workers": 1,
  "flaresolverr_max_concurrent": 1,
  "flaresolverr_session_name": "gtr-catalog",
  "flaresolverr_persist_session": true,
  "flaresolverr_keepalive_seconds": 240,
  "proxy_list": [],
  "proxies_file": "config/proxies.json",
  "session_dir": "out/browser_session",
  "flaresolverr_url": "http://127.0.0.1:8191/v1",
  "flaresolverr_timeout_ms": 60000,
  "use_flaresolverr": true,
  "allowed_path_substring": "/en/catalog/",
  "allowed_locale": "en",
  "allowed_brand": "nissan",
  "diagram_storage_prefix": "partsouq/nissan",
  "supabase_diagrams_bucket": "catalog-diagrams",
  "max_attempts": 5,
  "checkpoint_every": 10,
  "hierarchy_aware": true,
  "nhtsa_enrich": false,
  "run_until_complete": true,
  "completion_max_rounds": 5,
  "queue_deep_first": true,
  "queue_mode": "hybrid",
  "chassis_catalogs_path": "config/chassis_catalogs.json"
}
