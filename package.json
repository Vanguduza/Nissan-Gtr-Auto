{
  "name": "nissan-gtr-auto-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Nissan GTR Auto — composable ERP monorepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/supabase-client/src/database.types.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
