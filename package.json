{
  "name": "nissan-gtr-auto-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Nissan GTR Auto — composable ERP monorepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "dev:web": "pnpm --filter @gtr/web dev",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > packages/supabase-client/src/database.types.ts",
    "db:types:linked": "npx supabase gen types typescript --linked > packages/supabase-client/src/database.types.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
