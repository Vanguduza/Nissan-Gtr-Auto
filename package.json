{
  "name": "nissan-gtr-auto-erp",
  "private": true,
  "version": "0.1.0",
  "description": "Nissan GTR Auto \u2014 composable ERP monorepo",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --filter '!@gtr/web' run test && pnpm --filter @gtr/web test:unit",
    "lint": "eslint apps/web packages --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "dev:web": "pnpm --filter @gtr/web dev",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > packages/supabase-client/src/database.types.ts",
    "db:types:linked": "npx supabase gen types typescript --linked > packages/supabase-client/src/database.types.ts",
    "preview:hr-id-card": "node --experimental-strip-types scripts/simulate-hr-onboarding-id-card.mjs",
    "test:smoke:docs": "echo See docs/HARDENING.md \u2014 docker exec \u2026 psql for phase2_rls_smoke.sql and phase14_ci_smoke.sql",
    "staff:provision": "node scripts/provision-canonical-staff.mjs",
    "staff:verify": "node scripts/provision-canonical-staff.mjs --verify-only",
    "staff:rotate-passwords": "node scripts/provision-canonical-staff.mjs --rotate-passwords",
    "test:promptfoo": "npm --prefix promptfoo run gate",
    "test:web": "playwright test",
    "test:provenance": "python3 scripts/test_project_truth_guard.py && node --test scripts/test-web-environment.mjs scripts/test-public-production.mjs",
    "test:web:staff": "playwright test --config playwright.staff.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "1.2.2",
      "fast-uri@<3.1.9": "3.1.9"
    }
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16",
    "tsx": "^4.23.15"
  }
}
