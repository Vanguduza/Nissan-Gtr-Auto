# Local Supabase Auth OAuth — copy to supabase/.env and fill values.
# Never commit supabase/.env. CLI loads these for config.toml env(...) refs.
# After filling Google (and optionally Apple), set enabled = true under
# [auth.external.google] / [auth.external.apple] in config.toml, then
# `supabase stop` && `supabase start`. Checklist: docs/CUSTOMER_OAUTH_SETUP.md

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional — Apple Sign In (Services ID + secret JWT)
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
