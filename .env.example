# =============================================================================
# Hosted vs local — cutover checklist: docs/guides/hosted-supabase-cutover.md
# Project ref (docs/decisions/2026-07-23-remote-supabase-project.md): gylrgwqyuiwkyykardwc
#
# HOSTED (default templates below):
#   URL  = https://gylrgwqyuiwkyykardwc.supabase.co
#   Keys = Dashboard → Project Settings → API (anon + service_role)
#
# LOCAL Docker (after `pnpm db:start` / `supabase status`):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_URL=http://127.0.0.1:54321
#   Keys = local anon / service_role from `supabase status` (not the hosted JWTs)
# =============================================================================

# Public / client-safe (Next.js, mobile)
NEXT_PUBLIC_SITE_URL=https://nissangtrauto.co.zw
NEXT_PUBLIC_SUPABASE_URL=https://gylrgwqyuiwkyykardwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to browsers or mobile clients
SUPABASE_URL=https://gylrgwqyuiwkyykardwc.supabase.co
SUPABASE_ANON_KEY=
# Mobile apps (prefer Live when set): copy URL + anon into
#   apps/android-*/local.properties  (BuildConfig SUPABASE_URL / SUPABASE_ANON_KEY)
#   apps/ios/Secrets.xcconfig or Xcode scheme env
# Optional force Fake: android rpc.forceFake=true | ios STOREFRONT_FORCE_FAKE=1
# Google Maps (delivery route + customer address pick): local.properties only — never commit
#   GOOGLE_MAPS_API_KEY=...  # Maps SDK for Android + Directions API
# See apps/android-customer|.env.example, apps/android-management|.env.example,
# apps/android-delivery/.env.example, apps/ios/.env.example
# Dashboard → Settings → API → service_role (server only)
SUPABASE_SERVICE_KEY=

# Direct Postgres — replace PASSWORD with Dashboard database password
DATABASE_URL=postgresql://postgres:PASSWORD@db.gylrgwqyuiwkyykardwc.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Optional satellites — docker-compose.satellites.yml (see infra/satellites/README.md)
# Meilisearch CE local smoke; Postgres FTS remains production search until dual-read
# ---------------------------------------------------------------------------
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_MASTER_KEY=gtr_dev_meili_master_change_me
# MEILI_SEARCH_KEY=           # search-only key — Edge Function + local proxy (never NEXT_PUBLIC_*)
# CATALOG_SEARCH_BACKEND=meili # meili | fts — Edge catalog-search-meili fallback control
# TRACCAR_URL=http://127.0.0.1:8082
# OSRM_URL=http://127.0.0.1:5000

# ---------------------------------------------------------------------------
# Catalog scrape — FlareSolverr (local IP; PartSouq; no captcha SaaS)
# ---------------------------------------------------------------------------
# FLARESOLVERR_URL=http://127.0.0.1:8191/v1

# ---------------------------------------------------------------------------
# Worker AuthZ — process-sms-outbox / process-customer-receipts / demand-forecast
# / process-ai-reports
# Supabase Edge secrets ONLY (never commit values). Header: x-worker-secret
# ---------------------------------------------------------------------------
# WORKER_SHARED_SECRET=
# WORKER_ALLOW_UNVERIFIED_LOCAL=1

# ---------------------------------------------------------------------------
# Auth OTP (email | phone) — Edge function auth-otp
# Fail-closed without SMS/EMAIL secrets unless local stub flag set.
# Stub code when flag=1 and keys unset: 000000 (never enable flag in production;
# ENVIRONMENT=production / hosted SUPABASE_URL refuse stub even if flag set)
# Public GoTrue email signup is blocked by hook_before_user_created;
# OTP complete_signup (Admin API + gtr_provisioned_via=auth_otp) remains SoR for email/phone.
# ---------------------------------------------------------------------------
# AUTH_OTP_ALLOW_UNVERIFIED_LOCAL=1
# AUTH_OTP_FROM_EMAIL=noreply@nissangtrauto.co.zw
# AUTH_OTP_PROOF_SECRET=  # optional; defaults to SUPABASE_SERVICE_ROLE_KEY on Edge

# ---------------------------------------------------------------------------
# Customer OAuth (Google / Apple) — local Auth via config.toml env(); hosted = Dashboard
# Names only — never commit values. Checklist: docs/CUSTOMER_OAUTH_SETUP.md
# ---------------------------------------------------------------------------
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# ---------------------------------------------------------------------------
# AI staff analytics / CRM promos / stores insights — Edge secrets (never commit values)
# GEMINI_API_KEY: copy from local vault at deploy time (e.g. Claude-mem settings)
# See docs/plans/2026-08-03-ai-autonomous-erp-layer.md
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# REPORT_FROM_EMAIL=reports@nissangtrauto.co.zw
# Workers: process-ai-reports, process-crm-promos (x-worker-secret / WORKER_SHARED_SECRET)

# ---------------------------------------------------------------------------
# Manager SMS + customer receipt SMS — Edge secrets
# Assumed: POST {SMS_GATEWAY_BASE_URL}/messages  Authorization: Bearer …
# Body: { "to", "from"?, "text" } — see supabase/functions/README.md
# ---------------------------------------------------------------------------
# SMS_GATEWAY_API_KEY=
# SMS_GATEWAY_BASE_URL=https://sms.nissangtrauto.co.zw/v1
# SMS_GATEWAY_SENDER=GTRAuto

# ---------------------------------------------------------------------------
# Customer receipt email (Resend-compatible HTTP) — Edge secrets
# ---------------------------------------------------------------------------
# EMAIL_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=receipts@nissangtrauto.co.zw
# RECEIPT_FROM_EMAIL=receipts@nissangtrauto.co.zw
# REPORT_FROM_EMAIL=reports@nissangtrauto.co.zw
# EMAIL_API_BASE=https://api.resend.com

# ---------------------------------------------------------------------------
# Brevo — promo / CRM email only (process-crm-promos). Transactional stays Resend.
# Dial-a-Spare channel split: docs/DIAL_SPARE_ADOPTION_PLAN.md
# ---------------------------------------------------------------------------
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=crm@nissangtrauto.co.zw
# BREVO_FROM_NAME=Nissan GTR Auto
# BREVO_API_BASE=https://api.brevo.com
# CRM_FROM_EMAIL=crm@nissangtrauto.co.zw

# ---------------------------------------------------------------------------
# WhatsApp Cloud API — receipts outbound + parts-finder bot (Edge secrets)
# Shared client: supabase/functions/_shared/whatsapp_cloud.ts
# Bot webhook: whatsapp-webhook (verify_jwt=false; AuthZ = Meta signature)
# ---------------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_HANDOFF_NUMBER=263771234567
# SITE_URL=https://nissangtrauto.co.zw
# WHATSAPP_ALLOW_UNVERIFIED_LOCAL=1
# WHATSAPP_BOT_RATE_LIMIT_MAX=20
# WHATSAPP_BOT_RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# ContiPay / Paynow — Supabase Edge Function secrets ONLY (never commit values)
# Set via `supabase secrets set` / dashboard. See supabase/functions/README.md
# ---------------------------------------------------------------------------
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# PAYNOW_ALLOW_UNVERIFIED_LOCAL=1
# CONTIPAY_API_KEY=
# CONTIPAY_API_SECRET=
# CONTIPAY_MERCHANT_ID=
# CONTIPAY_WEBHOOK_HMAC_SECRET=
# CONTIPAY_MODE=live
# CONTIPAY_API_BASE_URL=
# CONTIPAY_ALLOW_UNVERIFIED_LOCAL=1

# ---------------------------------------------------------------------------
# Map tiles (MapLibre) — web storefront + staff live map
# Self-host: infra/satellites/maptiles/ (Planetiler + tileserver-gl).
#   NEXT_PUBLIC_MAP_STYLE_URL=http://127.0.0.1:8081/styles/basic-preview/style.json
# Emulator: MAPLIBRE_STYLE_URL=http://10.0.2.2:8081/styles/basic-preview/style.json
# Unset → web keyless CARTO Positron; native demotiles last resort.
# Optional production keyed URL (MapTiler etc.) still fine as env override.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MAP_STYLE_URL=http://127.0.0.1:8081/styles/basic-preview/style.json

# ---------------------------------------------------------------------------
# PowerSync (H7) — Android management Fake when unset; cloud E2E needs URL
# Names + connector: powersync/.env.example — never commit values.
# Infra ready — awaiting POWERSYNC_URL (+ public key) for cloud E2E.
# ---------------------------------------------------------------------------
# POWERSYNC_URL=
# POWERSYNC_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Temporal delivery-dispatch worker (§H H1) — host process, not Edge
# Fail-closed: packages/delivery-dispatch-worker refuses start without
# TEMPORAL_ADDRESS + SUPABASE_SERVICE_ROLE_KEY. See package .env.example.
# Infra ready — awaiting TEMPORAL_ADDRESS + service role for live run.
# ---------------------------------------------------------------------------
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=gtr-delivery-dispatch
# SUPABASE_SERVICE_ROLE_KEY=   # worker host only — never apps/*

# ---------------------------------------------------------------------------
# Promptfoo (H3) — optional real-provider CI; offline gate always runs
# See promptfoo/.env.example. Waiting on keys for real-provider job only.
# ---------------------------------------------------------------------------
# PROMPTFOO_PROVIDER=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
